{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://word-chaser.local/case.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "icon",
    "summary",
    "question",
    "startNodeId",
    "goalNodeIds",
    "completion",
    "partner",
    "sources",
    "nodes",
    "edges",
    "puzzles",
    "milestones"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/definitions/id"
    },
    "title": {
      "$ref": "#/definitions/text"
    },
    "icon": {
      "$ref": "#/definitions/text"
    },
    "summary": {
      "$ref": "#/definitions/text"
    },
    "question": {
      "$ref": "#/definitions/text"
    },
    "startNodeId": {
      "$ref": "#/definitions/id"
    },
    "goalNodeIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/id"
      }
    },
    "completion": {
      "$ref": "#/definitions/text"
    },
    "partner": {
      "$ref": "#/definitions/text"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "url"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "title": {
            "$ref": "#/definitions/text"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "form",
          "languageId",
          "eraId",
          "placeId",
          "offset",
          "period",
          "meaning",
          "pronunciation",
          "evidence"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "form": {
            "$ref": "#/definitions/text"
          },
          "languageId": {
            "$ref": "#/definitions/id"
          },
          "eraId": {
            "$ref": "#/definitions/id"
          },
          "placeId": {
            "$ref": "#/definitions/id"
          },
          "offset": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": -150,
              "maximum": 150
            }
          },
          "period": {
            "$ref": "#/definitions/text"
          },
          "meaning": {
            "$ref": "#/definitions/text"
          },
          "pronunciation": {
            "$ref": "#/definitions/pronunciation"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "title",
              "text",
              "notice",
              "sourceIds",
              "illustrative",
              "pages"
            ],
            "properties": {
              "kind": {
                "$ref": "#/definitions/id"
              },
              "title": {
                "$ref": "#/definitions/text"
              },
              "text": {
                "$ref": "#/definitions/text"
              },
              "notice": {
                "$ref": "#/definitions/text"
              },
              "sourceIds": {
                "$ref": "#/definitions/references"
              },
              "illustrative": {
                "type": "boolean"
              },
              "pages": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "title",
                    "text"
                  ],
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 260
                    }
                  }
                }
              }
            }
          },
          "mapCaption": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65
          },
          "mapLabelSide": {
            "enum": [
              "left",
              "right"
            ]
          },
          "mapTitle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65
          },
          "segments": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "id": {
                  "$ref": "#/definitions/id"
                }
              }
            }
          },
          "displayOffset": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": -120,
              "maximum": 120
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "target",
          "type",
          "evidence",
          "challenge"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "source": {
            "$ref": "#/definitions/id"
          },
          "target": {
            "$ref": "#/definitions/id"
          },
          "type": {
            "$ref": "#/definitions/id"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "text",
              "sourceIds"
            ],
            "properties": {
              "title": {
                "$ref": "#/definitions/text"
              },
              "text": {
                "$ref": "#/definitions/text"
              },
              "sourceIds": {
                "$ref": "#/definitions/references"
              }
            }
          },
          "challenge": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "prompt",
              "choices"
            ],
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "choices": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "label",
                    "correct",
                    "feedback"
                  ],
                  "properties": {
                    "id": {
                      "$ref": "#/definitions/id"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "correct": {
                      "type": "boolean"
                    },
                    "feedback": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 320
                    }
                  }
                }
              }
            }
          },
          "timeLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65
          },
          "sourceSegmentId": {
            "$ref": "#/definitions/id"
          }
        }
      }
    },
    "puzzles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "parts",
          "meaning",
          "text",
          "pronunciation",
          "sourceIds"
        ],
        "properties": {
          "title": {
            "$ref": "#/definitions/text"
          },
          "parts": {
            "$ref": "#/definitions/text"
          },
          "meaning": {
            "$ref": "#/definitions/text"
          },
          "text": {
            "$ref": "#/definitions/text"
          },
          "pronunciation": {
            "$ref": "#/definitions/pronunciation"
          },
          "sourceIds": {
            "$ref": "#/definitions/references"
          }
        }
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nodeId",
          "label"
        ],
        "properties": {
          "nodeId": {
            "$ref": "#/definitions/id"
          },
          "label": {
            "$ref": "#/definitions/text"
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "center",
        "width"
      ],
      "properties": {
        "center": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "width": {
          "type": "number",
          "minimum": 35,
          "maximum": 900
        }
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/id"
      }
    },
    "pronunciation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "languageId"
      ],
      "properties": {
        "text": {
          "$ref": "#/definitions/text"
        },
        "languageId": {
          "$ref": "#/definitions/id"
        }
      }
    }
  }
}
