{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "languages",
    "eras",
    "places",
    "relations",
    "artifacts",
    "cases",
    "rules",
    "modes",
    "collections"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^cases/[a-z][a-z0-9-]*\\.json$"
      }
    },
    "languages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "voiceTag",
          "voiceLabel",
          "approximate"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "voiceTag": {
            "type": "string",
            "minLength": 2
          },
          "voiceLabel": {
            "type": "string",
            "minLength": 1
          },
          "approximate": {
            "type": "boolean"
          },
          "fallback": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lang",
              "label"
            ],
            "properties": {
              "lang": {
                "type": "string",
                "minLength": 2
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "eras": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "label",
          "icon",
          "startYear",
          "endYear"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "startYear": {
            "type": "integer"
          },
          "endYear": {
            "type": "integer"
          }
        }
      }
    },
    "places": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "searchHint"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 900
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 650
          },
          "searchHint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "coordinates": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "number",
                "minimum": -85,
                "maximum": 85
              }
            ]
          }
        },
        "anyOf": [
          {
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {},
              "y": {}
            }
          },
          {
            "required": [
              "coordinates"
            ],
            "properties": {
              "coordinates": {}
            }
          }
        ]
      }
    },
    "relations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "category",
          "line",
          "outcome"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "ancestry",
              "related",
              "comparison"
            ]
          },
          "line": {
            "enum": [
              "solid",
              "dashed",
              "dotted"
            ]
          },
          "outcome": {
            "enum": [
              "connected",
              "excluded"
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "icon",
          "label"
        ],
        "properties": {
          "icon": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correctPoints",
        "assistedPoints",
        "wrongPenalty"
      ],
      "properties": {
        "correctPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "assistedPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "wrongPenalty": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "modes": {
      "type": "object",
      "required": [
        "chaser"
      ],
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/mode"
      },
      "properties": {
        "chaser": {
          "$ref": "#/definitions/mode"
        }
      }
    },
    "collections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "caseIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "caseIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "description",
        "instructions",
        "showMarkerDetails",
        "showPeeks",
        "allowHints",
        "restartOnWrong",
        "showUnvisitedMarkers",
        "showPeekDetails",
        "searchHintSeconds"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "instructions": {
          "type": "string",
          "minLength": 1
        },
        "showMarkerDetails": {
          "type": "boolean"
        },
        "showPeeks": {
          "type": "boolean"
        },
        "allowHints": {
          "type": "boolean"
        },
        "restartOnWrong": {
          "type": "boolean"
        },
        "showUnvisitedMarkers": {
          "type": "boolean"
        },
        "showPeekDetails": {
          "type": "boolean"
        },
        "searchHintSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        }
      }
    }
  }
}
