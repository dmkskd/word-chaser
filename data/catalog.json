  "modes": {
    "chaser": {
      "label": "Word Chaser",
      "description": "Explore with clues. Mistakes can be tried again.",
      "instructions": "Move or drag the glass over an object to reveal its word. Tap the object to test your theory. Ask for a little clue if you need one. Correct theories earn points; mistaken guesses reduce the reward. Keyboard: arrows move, Enter inspects, +/− zoom, P speaks, H gives a hint. Zoom with +/− or pinch. Use two fingers to pan, or Shift + arrow keys. Whole Europe shows the wider map.",
      "showMarkerDetails": true,
      "showPeeks": true,
      "allowHints": true,
      "restartOnWrong": false,
      "showUnvisitedMarkers": true,
      "showPeekDetails": true,
      "searchHintSeconds": 0
    },
    "investigator": {
      "label": "Investigator",
      "description": "Find hidden words. A location hint after 30 seconds. One wrong answer restarts the case.",
      "instructions": "Start with the visible word. Move or drag the glass around the map to uncover other words, then tap to test your theory. Decide Yes or No using what you know. After 30 seconds of searching, a location riddle gives you a nudge. One wrong answer restarts this case. Keyboard: arrows move, Enter opens a word, +/− zoom. Zoom with +/− or pinch. Use two fingers to pan, or Shift + arrow keys. Whole Europe shows the wider map.",
      "showMarkerDetails": false,
      "showPeeks": true,
      "allowHints": false,
      "restartOnWrong": true,
      "showUnvisitedMarkers": false,
      "showPeekDetails": false,
      "searchHintSeconds": 30
    }
  },
